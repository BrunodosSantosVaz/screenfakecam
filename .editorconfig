root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
ktlint_code_style = ktlint_official
max_line_length = 120
# Compose: @Composable functions are named like types (HomeScreen, ScreenFakeCamTheme).
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{yml,yaml,json,toml,md}]
indent_size = 2
